# Optional server-side AI integration. Never put keys in VITE_* variables.
# Load with: python -m uvicorn qore.main:app --env-file .env --host 127.0.0.1 --port 8000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# QORE_DB_PATH=data/qore.sqlite3

# QORE currently uses account-free browser workspaces and SQLite evidence.
# On Render, mount a persistent disk and point this path at that mount.
QORE_STORAGE=sqlite
QORE_PUBLIC_URL=http://127.0.0.1:8000
# QORE_DB_PATH=/var/data/qore.sqlite3
