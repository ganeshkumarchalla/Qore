# Optional server-side AI integration. Never put keys in VITE_* variables.
# Load with: python -m uvicorn qore.main:app --env-file .env --host 127.0.0.1 --port 8000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# QORE_DB_PATH=data/qore.sqlite3

# Production identity and private workspace storage. Server-side only.
# Copy the publishable key from your project's API settings; never use service_role.
SUPABASE_URL=https://yxelmlwtggjgbvjpkmrx.supabase.co
SUPABASE_PUBLISHABLE_KEY=
QORE_STORAGE=supabase
QORE_REQUIRE_AUTH=true
QORE_PUBLIC_URL=http://127.0.0.1:8000
# Email/password only. Enable email confirmation and configure production SMTP
# in Supabase Auth. Allow this origin's /?email_confirmation=opened redirect.
# On Render use QORE_ENV=production and your HTTPS origin for QORE_PUBLIC_URL.
# Unconfigured local development uses SQLite without an account. Do not copy
# the production settings above into an unauthenticated local test environment.
