# Replace QORE_PUBLIC_IP after obtaining a trusted certificate for that IP.
# The application container listens only on 127.0.0.1:8080.
server {
    listen 80;
    server_name QORE_PUBLIC_IP;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/qore-acme;
        default_type text/plain;
    }
    location / { return 404; }
}

server {
    listen 443 ssl;
    server_name QORE_PUBLIC_IP;
    ssl_certificate /etc/letsencrypt/live/QORE_PUBLIC_IP/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/QORE_PUBLIC_IP/privkey.pem;
    client_max_body_size 96k;

    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
        proxy_buffering off;
    }

    location / { return 404; }
}
